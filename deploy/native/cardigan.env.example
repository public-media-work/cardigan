# /etc/cardigan/cardigan.env — non-secret runtime settings for the native
# deployment (#470). install.sh copies this into place if absent; edit the
# live copy, not this file. Secrets live in /etc/cardigan/secrets.env, written
# by scripts/sync-native-secrets.sh from the Mac.

# State (on the ocean/cardigan ZFS bind mount)
DATABASE_PATH=/var/lib/cardigan/db/dashboard.db
OUTPUT_DIR=/var/lib/cardigan/output
TRANSCRIPTS_DIR=/var/lib/cardigan/transcripts
MEDIA_DIR=/var/lib/cardigan/media
# Settings-page writes land here; seeded additively from config/llm-config.json (#440)
LLM_CONFIG_PATH=/var/lib/cardigan/config/llm-config.json
# Glossary is app-written data; keep it out of the git checkout
KNOWLEDGE_DIR=/var/lib/cardigan/knowledge

# Logs (not backed up)
LOGS_DIR=/var/log/cardigan

# The dashboard is same-origin through nginx, so CORS only matters for other
# browser clients hitting :8100 directly.
CORS_ORIGINS=http://cardigan01:3100,http://cardigan02:3100,https://cardigan.riechers.co

LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Optional local LLM backend (same defaults as docker-compose.prod.yml)
#LOCAL_LLM_ENDPOINT=http://studio.riechers.co:8000/v1/chat/completions
#LOCAL_LLM_MODEL=
