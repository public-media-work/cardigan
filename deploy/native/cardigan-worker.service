[Unit]
Description=Cardigan job worker
Documentation=https://github.com/public-media-work/cardigan/blob/main/deploy/native/README.md
# The API's ExecStartPre runs migrations; start after it so the schema is current.
After=network-online.target cardigan-api.service
Wants=network-online.target cardigan-api.service

[Service]
Type=simple
User=cardigan
Group=cardigan
WorkingDirectory=/opt/cardigan
EnvironmentFile=/etc/cardigan/cardigan.env
EnvironmentFile=-/etc/cardigan/secrets.env
ExecStart=/opt/cardigan-venv/bin/python run_worker.py
Restart=on-failure
RestartSec=10
# Give an in-flight phase time to wind down on restart.
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
